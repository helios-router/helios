#!/usr/bin/env python3
"""Stand-in for Authelia's CLI (storage user webauthn|totp ...): keeps passkeys and
TOTP keys in $STUB_AUTHELIA_DB (JSON) and records each call in $STUB_LOG."""
import json
import os
import sys

args = sys.argv[1:]
with open(os.environ.get("STUB_LOG", "/dev/null"), "a") as log:
    log.write("authelia " + " ".join(args) + "\n")
db_path = os.environ["STUB_AUTHELIA_DB"]
db = {"webauthn": [], "totp": []}
if os.path.exists(db_path):
    with open(db_path) as f:
        db = json.load(f)
if not os.environ.get("AUTHELIA_STORAGE_ENCRYPTION_KEY_FILE"):
    sys.exit("no encryption key")
a = [x for x in args if x != "--config"]


def save():
    with open(db_path, "w") as f:
        json.dump(db, f)


def export(key, rows):
    """YAML, as Authelia 4.39 writes it whatever the file is called (and, like
    it, an error when there's nothing to export)."""
    if not rows:
        sys.stderr.write("Error: no data to export\n\nUsage:\n  authelia storage user export [flags]\n")
        sys.exit(1)
    lines = ["# yaml-language-server: $schema=https://www.authelia.com/schemas/v4.39/json-schema/exports.%s.json" % key, key + ":"]
    for row in rows:
        first = True
        for k, v in row.items():
            text = "null" if v is None else ("true" if v is True else "false" if v is False else "'%s'" % str(v).replace("'", "''"))
            lines.append(("  - " if first else "    ") + "%s: %s" % (k, text))
            first = False
        lines += ["    transports:", "      - usb"] if key.startswith("webauthn") else []
    with open(a[a.index("--file") + 1], "w") as f:
        f.write("\n".join(lines) + "\n")


# A fixed, public test value (the RFC 6238 example key), not a real credential
TEST_KEY_B32 = "JBSWY3DPEHPK3PXPJBSWY3DPEHPK3PXP"

if a[:4] == ["storage", "user", "webauthn", "export"]:
    export("webauthn_credentials", db["webauthn"])
elif a[:4] == ["storage", "user", "totp", "export"]:
    export("totp_configurations", db["totp"])
elif a[:4] == ["storage", "user", "webauthn", "delete"]:
    kid = a[a.index("--kid") + 1]
    db["webauthn"] = [c for c in db["webauthn"] if c["kid"] != kid]
    save()
elif a[:4] == ["storage", "user", "totp", "delete"]:
    db["totp"] = [c for c in db["totp"] if c["username"] != a[4]]
    save()
elif a[:4] == ["storage", "user", "totp", "generate"]:
    user = a[4]
    db["totp"] = [c for c in db["totp"] if c["username"] != user] + [{"username": user, "key": TEST_KEY_B32}]
    save()
    sys.stdout.write("Successfully generated TOTP configuration for user '%s' with URL '%s'\n"
                     % (user, "otpauth://totp/HeliOS:" + user + "?issuer=HeliOS&secret=" + TEST_KEY_B32))
else:
    sys.exit("stub authelia: unsupported " + " ".join(args))
