#!/bin/sh
# wg genkey / wg pubkey (stdin): fake but deterministic-looking base64 keys; records argv
echo "wg $*" >> "${STUB_LOG:-/dev/null}"
case "$1" in
  genkey) echo "cHJpdmF0ZWtleS1mb3ItdGVzdHMtb25seS0wMDAwMDA=" ;;
  pubkey) read k; echo "pub-of-$(echo "$k" | cut -c1-8)=" ;;
  *) exit 1 ;;
esac
