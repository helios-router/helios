# The real Heliopause rulesets for tests/netns/firewall.py, generated by
# modules/heliopause.nix from the template site. Each variant changes one
# permission, so the test can load one, open connections, load the next (what an
# Apply does) and see what happens to them. The test's machines are named here,
# so restrictUnnamed doesn't quarantine them.
#
#   nix build .#heliopauseRulesets   →   result/<variant>.nft
{ lib, pkgs, example }:

let
  template = builtins.fromJSON (builtins.readFile ../../templates/state.json);
  # MACs and addresses tests/netns/firewall.py gives its machines
  devices = [
    { mac = "02:00:00:00:00:20"; name = "t-laptop"; vlan = "trusted"; ip = "10.20.0.100"; profile = "default"; }
    { mac = "02:00:00:00:00:30"; name = "f-tablet"; vlan = "family"; ip = "10.30.0.100"; profile = "default"; }
    { mac = "02:00:00:00:00:40"; name = "i-camera"; vlan = "iot"; ip = "10.40.0.100"; profile = "default"; }
  ];
  access = name: acc: map (n: if n.name == name then n // { access = (n.access or { }) // acc; } else n) template.networks;
  site = networks: devs: template // { inherit networks; devices = devs; };
  variants = {
    base = site template.networks devices;
    # family may open connections to iot (iot may not open them to family)
    family-reaches-iot = site (access "family" { reach = [ "iot" ]; }) devices;
    # ...and the family tablet forgotten: unnamed, so quarantined on family
    family-reaches-iot-unnamed = site (access "family" { reach = [ "iot" ]; }) (builtins.filter (d: d.vlan != "family") devices);
    iot-no-internet = site (access "iot" { internet = false; }) devices;
    iot-admin = site (access "iot" { admin = true; }) devices;
  };
  ruleset = state: (example.extendModules { modules = [ { helios.state = lib.mkForce state; } ]; }).config.networking.nftables.ruleset;
in
pkgs.runCommand "heliopause-rulesets" { } (''
  mkdir $out
'' + lib.concatStrings (lib.mapAttrsToList (name: state: ''
  cp ${pkgs.writeText "${name}.nft" (ruleset state)} $out/${name}.nft
'') variants))
